# Copy to .env or set in your shell. All optional.
# Full path to your trained garbage model (Windows example):
# CITYLENS_GARBAGE_MODEL=C:\path\to\runs\detect\citylens_garbage-2\weights\best.pt
# CITYLENS_POTHOLE_MODEL=models/citylens_pothole.pt
# CITYLENS_VEHICLE_MODEL=yolov8n.pt        # empty value disables parking detection
# CITYLENS_CONF=0.35                       # detection confidence threshold
# CITYLENS_CLAHE=0                         # 1 = contrast boost for dark photos
# CITYLENS_ID_START=122                    # first complaint = CL-<year>-00123
