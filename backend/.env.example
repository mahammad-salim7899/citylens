# Copy to .env or set in your shell. All optional unless marked otherwise.

# ── Models ───────────────────────────────────────────────────────────
# Full path to your trained garbage model (Windows example):
# CITYLENS_GARBAGE_MODEL=C:\path\to\runs\detect\citylens_garbage-2\weights\best.pt
# CITYLENS_POTHOLE_MODEL=models/citylens_pothole.pt
# CITYLENS_VEHICLE_MODEL=yolov8n.pt        # empty value disables parking detection
# CITYLENS_CONF=0.35                       # detection confidence threshold
# CITYLENS_CLAHE=0                         # 1 = contrast boost for dark photos
# CITYLENS_ID_START=122                    # first complaint = CL-<year>-00123

# ── Authentication ───────────────────────────────────────────────────
# REQUIRED before deploying anywhere. Any long random string; everyone's
# tokens stop working if you change it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left unset, the server generates one and keeps it in data/.jwt_secret
# so restarts don't sign you out — fine for development only.
# CITYLENS_JWT_SECRET=

# CITYLENS_JWT_TTL_HOURS=12                # how long a login lasts
# CITYLENS_PBKDF2_ROUNDS=240000            # password hashing cost

# Password given to the three seeded officer accounts, which are created
# only on a brand-new database. CHANGE THIS before any deployment.
# CITYLENS_SEED_OFFICER_PASSWORD=citylens-demo
